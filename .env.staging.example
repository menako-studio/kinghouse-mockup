# ==============================================================================
# KINGHOUSE - STAGING / DEVELOPMENT ENVIRONMENT (.env.local)
# Gunakan kredensial dari Project Supabase: kinghouse-staging
# ==============================================================================

NEXT_PUBLIC_ENVIRONMENT=staging

# Supabase Staging Database (Free Tier Project 1)
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
NEXT_PUBLIC_SUPABASE_SCHEMA=public

# Session Secret (Staging)
AUTH_SECRET_KEY=kinghouse_staging_secret_key_2026_salt

# Base URL Local / Staging
NEXT_PUBLIC_SITE_URL=http://localhost:3000
